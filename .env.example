# Copia este archivo a .env para ejecutar en local (sin Docker).
# Todas las variables llevan el prefijo RTLLM_ (ver backend/app/config.py).

# Host de Ollama (HTTP plano por defecto)
RTLLM_OLLAMA_HOST=http://localhost:11434

# Modelos por defecto para los tres roles
RTLLM_DEFAULT_ATTACKER_MODEL=llama3.1:8b
RTLLM_DEFAULT_TARGET_MODEL=llama3.1:8b
RTLLM_DEFAULT_JUDGE_MODEL=llama3.1:8b

# Timeout de cada petición a Ollama, en segundos
RTLLM_OLLAMA_REQUEST_TIMEOUT=120

# Base de datos (SQLite)
RTLLM_DATABASE_URL=sqlite+aiosqlite:///./data/redteam.db

# Carpeta del panel web (en ejecución local, desde la raíz del repo)
RTLLM_FRONTEND_DIR=./frontend

# Lista blanca de hosts contra los que se permite lanzar campañas (JSON).
# Añade un host SOLO si tienes autorización explícita para probarlo.
RTLLM_ALLOWED_TARGET_HOSTS=["localhost","127.0.0.1","ollama"]
